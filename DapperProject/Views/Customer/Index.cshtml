@model List<ResultCustomerDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalCount = ViewBag.TotalCount;
    string search = ViewBag.Search ?? "";
}

<div class="page-header">
    @await Component.InvokeAsync("_AdminLayoutCustomerComponentPartial")
    <div class="page-header-actions">
        <a asp-controller="Customer" asp-action="CreateCustomer" class="btn btn-primary" style="text-decoration: none;">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            Müşteri Ekle
        </a>
    </div>
</div>

<div class="card">
    <div class="table-toolbar">
        <div class="toolbar-search">
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" style="color:var(--text-muted)">
                <circle cx="5.5" cy="5.5" r="4" stroke="currentColor" stroke-width="1.3" />
                <path d="M9 9l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
            <input type="text"
                   id="searchInput"
                   placeholder="Müşteri ara (Ad, Soyad veya Şehir)..."
                   value="@search"
                   onkeyup="if(event.key==='Enter') searchServer(this.value)">
        </div>
        <div class="toolbar-right">
            <span class="result-count" id="resultCount">@totalCount.ToString("N0") müşteri listeleniyor</span>
        </div>
    </div>

    <div style="overflow-x:auto">
        <table class="prod-table">
            <thead>
                <tr>
                    <th style="width:44px">
                        <input type="checkbox" class="checkbox" id="selectAll" onchange="toggleAll(this)">
                    </th>
                    <th>Müşteri Bilgileri</th>
                    <th>Şehir</th>
                    <th>Ülke</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><input type="checkbox" class="checkbox row-cb"></td>
                            <td>
                                <div class="prod-name-cell">
                                    <div>
                                        <div class="prod-name">@item.Name @item.Surname</div>
                                        <div class="prod-sku">ID: #@item.CustomerId</div>
                                    </div>
                                </div>
                            </td>
                            <td>@item.City</td>
                            <td>
                                <span class="badge" style="background:var(--hover-bg); color:var(--text-primary); padding: 4px 8px; border-radius:4px; font-size:11px;">
                                    @item.Country
                                </span>
                            </td>
                            <td>
                                <div class="action-btns">
                                    <a asp-controller="Customer"
                                       asp-action="UpdateCustomer"
                                       asp-route-id="@item.CustomerId"
                                       class="action-btn edit">
                                        <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                            <path d="M8.5 2.5l2 2L4 11H2v-2L8.5 2.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                                        </svg>
                                    </a>
                                    <a asp-controller="Customer"
                                       asp-action="DeleteCustomer"
                                       asp-route-id="@item.CustomerId"
                                       class="action-btn delete"
                                       onclick="return confirm('@item.Name @item.Surname silinsin mi?')">
                                        <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                            <path d="M2 3.5h9M5 3.5V2h3v1.5M4.5 3.5l.5 7h3l.5-7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align:center;padding:40px;color:var(--text-muted)">
                            <div style="font-size:32px;margin-bottom:8px">🔍</div>
                            <div>"@search" için müşteri bulunamadı</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="pagination-wrap">
            <div class="pagination-info">
                Sayfa <strong>@currentPage</strong> / @totalPages.ToString("N0")
                &nbsp;·&nbsp;
                Toplam <strong>@totalCount.ToString("N0")</strong> kayıt
            </div>

            <div class="pagination">
                @if (currentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@search" class="page-btn">
                        <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                            <path d="M8 2L4 6.5 8 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>
                }

                @for (int i = 1; i <= totalPages; i++)
                {
                    if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                    {
                        <a asp-action="Index" asp-route-page="@i" asp-route-search="@search"
                           class="page-btn @(i == currentPage ? "active" : "")">@i</a>
                    }
                    else if (i == currentPage - 3 || i == currentPage + 3)
                    {
                        <span class="page-dots">···</span>
                    }
                }

                @if (currentPage < totalPages)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@search" class="page-btn">
                        <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                            <path d="M5 2l4 4.5L5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>
                }
            </div>
        </div>
    }
</div>
<style>
    /* Sayfalama Alanını Kapsayan Ana Kap */
    .pagination-wrap {
        display: flex;
        align-items: center;
        justify-content: space-between; /* İçeriği iki uca yaslar */
        padding: 20px;
        margin-top: 10px;
        border-top: 1px solid rgba(255, 255, 255, 0.05); /* İnce bir çizgi */
        background: rgba(255, 255, 255, 0.02); /* Çok hafif bir arka plan */
    }

    /* Sol taraftaki "Sayfa x / y" metni */
    .pagination-info {
        font-size: 13px;
        color: var(--text-muted, #94a3b8);
        font-weight: 500;
    }

    /* Sağ taraftaki buton grubu */
    .pagination {
        display: flex;
        align-items: center;
        gap: 6px; /* Butonlar arası boşluk */
    }

    .page-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 36px;
        height: 36px;
        padding: 0 12px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        color: #cbd5e1;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .page-btn:hover:not(.disabled):not(.active) {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--accent-cyan, #06b6d4);
            color: #fff;
            transform: translateY(-1px);
        }

        .page-btn.active {
            background: var(--accent-cyan, #06b6d4);
            color: #fff;
            border-color: var(--accent-cyan, #06b6d4);
            box-shadow: 0 4px 12px rgba(6, 182, 212, 0.3);
        }

        .page-btn.disabled {
            opacity: 0.2;
            cursor: not-allowed;
        }

    .page-dots {
        color: var(--text-muted, #94a3b8);
        padding: 0 4px;
        letter-spacing: 2px;
    }
</style>
<script>
    function searchServer(value) {
        window.location.href = '/Customer/Index?search=' + encodeURIComponent(value) + '&page=1';
    }

    function toggleAll(source) {
        document.querySelectorAll('.row-cb').forEach(cb => cb.checked = source.checked);
    }
</script>