@model CreateCustomerDto
@{
    ViewData["Title"] = "Müşteri Ekle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-header">
    <div class="page-header-actions">
        <a asp-controller="Customer" asp-action="Index" class="btn btn-secondary" style="text-decoration:none;">
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                <path d="M8 2L4 6.5 8 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Geri Dön
        </a>
    </div>
</div>

<div class="card create-card">
    <div class="form-card-header">
        <div class="form-card-icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M12 7c0 1.657-1.343 3-3 3S6 8.657 6 7s1.343-3 3-3 3 1.343 3 3zM3 16s1-4 6-4 6 4 6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
        </div>
        <div>
            <div class="form-card-title">Yeni Müşteri</div>
            <div class="form-card-sub">Sisteme yeni bir müşteri profili ekleyin</div>
        </div>
    </div>

    <form asp-action="CreateCustomer" asp-controller="Customer" method="post" class="create-form">
        <div class="form-row">
            <div class="form-group">
                <label class="form-label" asp-for="Name">Ad <span class="required-dot">*</span></label>
                <input asp-for="Name" class="form-input" placeholder="örn: Ahmet" autocomplete="off" required />
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Surname">Soyad <span class="required-dot">*</span></label>
                <input asp-for="Surname" class="form-input" placeholder="örn: Yılmaz" autocomplete="off" required />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" asp-for="City">Şehir <span class="required-dot">*</span></label>
                <input asp-for="City" class="form-input" placeholder="örn: İstanbul" required />
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Country">Ülke <span class="required-dot">*</span></label>
                <input asp-for="Country" class="form-input" placeholder="örn: Türkiye" required />
            </div>
        </div>

        <div class="form-actions">
            <a asp-controller="Customer" asp-action="Index" class="btn btn-secondary" style="text-decoration:none;">İptal</a>
            <button type="submit" class="btn btn-primary">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                    <path d="M2 7l3.5 3.5L11 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Müşteriyi Kaydet
            </button>
        </div>
    </form>
</div>

@* Style bloğunu Product sayfanızla aynı tuttum, böylece görsel bütünlük bozulmaz *@
<style>
    .create-card {
        max-width: 640px;
        margin: 40px auto;
    }

    .form-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 24px 24px 20px;
        border-bottom: 1px solid var(--border-color);
    }

    .form-card-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: var(--accent-cyan, #06b6d4);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .form-card-title {
        font-size: 15px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .form-card-sub {
        font-size: 12px;
        color: var(--text-muted);
        margin-top: 2px;
    }

    .create-form {
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 500;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .required-dot {
        color: #ef4444;
        font-size: 15px;
        line-height: 1;
    }

    .form-input {
        height: 38px;
        padding: 0 12px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        background: transparent;
        color: var(--text-primary);
        font-size: 13px;
        transition: border-color .15s, box-shadow .15s;
        outline: none;
        width: 100%;
        box-sizing: border-box;
    }

        .form-input:focus {
            border-color: var(--accent-cyan, #06b6d4);
            box-shadow: 0 0 0 3px rgba(6,182,212,.12);
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding-top: 16px;
        border-top: 1px solid var(--border-color);
    }
</style>