@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

    @await Component.InvokeAsync("_DashboardHeadComponentPartial")

<body>

    <div class="glow-mesh"></div>

    <div class="app-shell">

        @await Component.InvokeAsync("_AdminLayoutSidebarComponentPartial")

        <!-- MAIN CONTENT -->
        <div class="main-content">

            @await Component.InvokeAsync("_AdminLayoutNavbarComponentPartial")

            <!-- DASHBOARD PAGE -->
            <div class="page-content">

                @await Component.InvokeAsync("_DashboarHeaderComponentPartial")

                <!-- KPI CARDS -->
                @await Component.InvokeAsync("_DashboardChart1ComponentPartial")


                <!-- CHARTS ROW 2 -->
                @await Component.InvokeAsync("_DashboardChart3ComponentPartial")

                <!-- BOTTOM SECTION -->
                @await Component.InvokeAsync("_DashboardChart4ComponentPartial")

            </div>
        </div>
    </div>

    <script>
        document.getElementById('menuToggle').addEventListener('click', function() {
          document.getElementById('sidebar').classList.toggle('open');
        });
    </script>
</body>
</html>