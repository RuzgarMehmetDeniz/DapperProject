@using DapperProject.Dtos.OrderDtos
@model GetByIdOrderDto
@{
    ViewData["Title"] = "Sipariş Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-header">
    <div class="page-header-actions">
        <a asp-controller="Order" asp-action="Index" class="btn btn-secondary" style="text-decoration: none;">
            Geri Dön
        </a>
    </div>
</div>

<div class="card" style="max-width:600px;margin:0 auto;">
    <div style="padding:24px;">
        <h2 style="font-size:16px;font-weight:600;margin-bottom:24px;color:var(--text-primary)">Sipariş Güncelle #@Model.OrderId</h2>

        <form asp-controller="Order" asp-action="UpdateOrder" method="post">

            <input type="hidden" asp-for="OrderId" />

            <div class="form-group">
                <label class="form-label">Müşteri</label>
                <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-control">
                    <option value="">-- Müşteri Seçin --</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Ürün</label>
                <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-control">
                    <option value="">-- Ürün Seçin --</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Adet</label>
                <input asp-for="Quantity" type="number" min="1" class="form-control" placeholder="Adet giriniz" />
            </div>

            <div class="form-group">
                <label class="form-label">Fiyat</label>
                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="Fiyat giriniz" />
            </div>

            <div class="form-group">
                <label class="form-label">Durum</label>
                <select asp-for="Status" class="form-control">
                    <option value="">-- Durum Seçin --</option>
                    <option value="Pending">Beklemede</option>
                    <option value="Shipped">Kargoda</option>
                    <option value="Cancelled">İptal</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Sipariş Tarihi</label>
                <input asp-for="OrderDate" type="text" class="form-control" disabled
                       value="@Model.OrderDate.ToString("dd.MM.yyyy")" />
            </div>

            <div style="display:flex;gap:12px;margin-top:32px;">
                <button type="submit" class="btn btn-primary" style="flex:1;">
                    Güncelle
                </button>
                <a asp-controller="Order" asp-action="Index" class="btn btn-secondary" style="flex:1;text-align:center;text-decoration:none;">
                    İptal
                </a>
            </div>

        </form>
    </div>
</div>

<style>
    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        display: block;
        font-size: 13px;
        font-weight: 500;
        color: var(--text-muted);
        margin-bottom: 6px;
    }

    .form-control {
        width: 100%;
        padding: 10px 14px;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.05);
        color: var(--text-primary);
        font-size: 14px;
        outline: none;
        transition: border-color 0.2s;
        box-sizing: border-box;
    }

        .form-control:focus {
            border-color: var(--accent-cyan, #06b6d4);
        }

        .form-control:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .form-control option {
            background: #1e293b;
            color: var(--text-primary);
        }
</style>