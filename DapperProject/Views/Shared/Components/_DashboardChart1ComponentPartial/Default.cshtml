@model DashboardKpiViewModel

<div class="kpi-grid">
    <div class="kpi-card" style="--kpi-glow:rgba(0,212,255,0.04);--kpi-border:rgba(0,212,255,0.2);--kpi-shadow:var(--shadow-glow-cyan);--kpi-icon-bg:rgba(0,212,255,0.1);--kpi-color:var(--accent-cyan)">
        <div class="kpi-top">
            <div class="kpi-icon-wrap"><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 2L14.196 4.92V10.75L9 13.67L3.804 10.75V4.92L9 2Z" stroke="currentColor" stroke-width="1.6" /><path d="M9 2v11.67M3.804 4.92l5.196 3 5.196-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg></div>
            <div class="kpi-trend up">↑ Toplam</div>
        </div>
        <div class="kpi-value">@Model.TotalOrders.ToString("N0")</div>
        <div class="kpi-label">Toplam Sipariş</div>
        <div class="kpi-sparkline"><svg viewBox="0 0 120 36" preserveAspectRatio="none"><defs><linearGradient id="sp1" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="#00d4ff" /><stop offset="100%" stop-color="#3b82f6" /></linearGradient></defs><polyline points="0,28 20,24 40,26 60,18 80,20 100,12 120,8" fill="none" stroke="url(#sp1)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
    </div>

    <div class="kpi-card" style="--kpi-glow:rgba(16,217,131,0.04);--kpi-border:rgba(16,217,131,0.2);--kpi-shadow:0 0 40px rgba(16,217,131,0.1);--kpi-icon-bg:rgba(16,217,131,0.1);--kpi-color:var(--accent-emerald)">
        <div class="kpi-top">
            <div class="kpi-icon-wrap"><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="2" y="2" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.6" /><rect x="10" y="2" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.6" /><rect x="2" y="10" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.6" /><rect x="10" y="10" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.6" /></svg></div>
            <div class="kpi-trend up">↑ Aktif</div>
        </div>
        <div class="kpi-value">@Model.ActiveCategories</div>
        <div class="kpi-label">Aktif Kategori</div>
        <div class="kpi-sparkline"><svg viewBox="0 0 120 36" preserveAspectRatio="none"><polyline points="0,32 20,28 40,30 60,22 80,18 100,14 120,10" fill="none" stroke="#10d983" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
    </div>

    <div class="kpi-card" style="--kpi-glow:rgba(139,92,246,0.04);--kpi-border:rgba(139,92,246,0.2);--kpi-shadow:var(--shadow-glow-violet);--kpi-icon-bg:rgba(139,92,246,0.1);--kpi-color:var(--accent-violet)">
        <div class="kpi-top">
            <div class="kpi-icon-wrap"><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M2 14l4-4 3 2.5 5-6.5 2 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
            <div class="kpi-trend up">↑ @Model.MonthlyGrowthPercent.ToString("F1")%</div>
        </div>
        <div class="kpi-value">%@Model.MonthlyGrowthPercent.ToString("F1")</div>
        <div class="kpi-label">Aylık Büyüme</div>
        <div class="kpi-sparkline"><svg viewBox="0 0 120 36" preserveAspectRatio="none"><polyline points="0,30 20,26 40,20 60,24 80,14 100,10 120,6" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
    </div>

    <div class="kpi-card" style="--kpi-glow:rgba(245,158,11,0.04);--kpi-border:rgba(245,158,11,0.2);--kpi-shadow:0 0 40px rgba(245,158,11,0.1);--kpi-icon-bg:rgba(245,158,11,0.1);--kpi-color:var(--accent-amber)">
        <div class="kpi-top">
            <div class="kpi-icon-wrap"><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="1.6" /><path d="M9 5v8M6.5 6.5c0-1 1.12-1.5 2.5-1.5s2.5.67 2.5 1.5c0 1.5-5 2-5 3.5 0 1.17 1.12 2 2.5 2s2.5-.83 2.5-2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg></div>
            <div class="kpi-trend up">↑ Bu Ay</div>
        </div>
        <div class="kpi-value">@Model.RevenueThisMonth.ToString("C0")</div>
        <div class="kpi-label">Bu Ayki Ciro</div>
        <div class="kpi-sparkline"><svg viewBox="0 0 120 36" preserveAspectRatio="none"><polyline points="0,32 20,28 40,26 60,20 80,16 100,14 120,8" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
    </div>

    <div class="kpi-card" style="--kpi-glow:rgba(59,130,246,0.04);--kpi-border:rgba(59,130,246,0.2);--kpi-shadow:var(--shadow-glow-blue);--kpi-icon-bg:rgba(59,130,246,0.1);--kpi-color:var(--accent-blue)">
        <div class="kpi-top">
            <div class="kpi-icon-wrap"><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="1.6" /><path d="M9 4v1M9 13v1M4 9H5M13 9h1M5.64 5.64l.71.71M11.64 11.64l.71.71M5.64 12.36l.71-.71M11.64 6.36l.71-.71" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /><circle cx="9" cy="9" r="2" stroke="currentColor" stroke-width="1.4" /></svg></div>
            <div class="kpi-trend up">↑ Ortalama</div>
        </div>
        <div class="kpi-value">@Model.AverageOrderValue.ToString("C0")</div>
        <div class="kpi-label">Ort. Sipariş Değeri</div>
        <div class="kpi-sparkline"><svg viewBox="0 0 120 36" preserveAspectRatio="none"><polyline points="0,10 20,10 40,12 60,10 80,8 100,10 120,10" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
    </div>

    <div class="kpi-card" style="--kpi-glow:rgba(244,63,94,0.04);--kpi-border:rgba(244,63,94,0.2);--kpi-shadow:0 0 40px rgba(244,63,94,0.1);--kpi-icon-bg:rgba(244,63,94,0.1);--kpi-color:var(--accent-rose)">
        <div class="kpi-top">
            <div class="kpi-icon-wrap"><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 2v14M2 9h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg></div>
            <div class="kpi-trend up">↑ Bugün</div>
        </div>
        <div class="kpi-value">@Model.NewOrdersToday.ToString("N0")</div>
        <div class="kpi-label">Bugünkü Siparişler</div>
        <div class="kpi-sparkline"><svg viewBox="0 0 120 36" preserveAspectRatio="none"><polyline points="0,28 20,20 40,24 60,16 80,10 100,14 120,8" fill="none" stroke="#f43f5e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
    </div>
</div>